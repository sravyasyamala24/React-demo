{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install React dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build hill climb game",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Run hill climb game",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--",
				"--host",
				"0.0.0.0"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Install realtime server packages",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"express",
				"socket.io",
				"socket.io-client"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Check realtime server syntax",
			"type": "shell",
			"command": "node",
			"args": [
				"--check",
				"server.js"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build full-stack game client",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Rebuild full-stack game client",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install development task runner",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--save-dev",
				"concurrently"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run full-stack hill climb",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Stop stale Vite listener",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-NetTCPConnection -LocalPort 5173 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force }"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final production build",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final backend syntax check",
			"type": "shell",
			"command": "node",
			"args": [
				"--check",
				"server.js"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}